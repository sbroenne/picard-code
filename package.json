{
  "name": "picard-code",
  "version": "1701.4.9",
  "description": "Speak to OpenCode the way Captain Picard spoke to the ship's computer. An unofficial, voice-only tribute that runs on your own computer.",
  "keywords": [
    "opencode",
    "voice",
    "speech",
    "nemotron",
    "kokoro",
    "star-trek",
    "picard",
    "coding-agent"
  ],
  "homepage": "https://sbroenne.github.io/picard-code/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbroenne/picard-code.git"
  },
  "bugs": {
    "url": "https://github.com/sbroenne/picard-code/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "picard-code": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "web-dist/",
    "scripts/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "prestart": "npm install --include=dev && npm run build",
    "start": "node dist/server/cli.js",
    "dev": "npm run build && node tools/dev.mjs",
    "test": "node --test dist/tests/*.test.js",
    "check": "oxlint --deny-warnings && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test:browser": "playwright test",
    "opencode": "node dist/server/cli.js opencode",
    "test:live": "node dist/tests/live-check.js",
    "test:crew:live": "node dist/tests/crew-live-check.js",
    "test:speech:live": "node dist/tests/speech-live-check.js",
    "test:speech:local": "node dist/tests/speech-local-check.js",
    "test:conversation:live": "node dist/tests/conversation-live-check.js",
    "test:behavior:live": "node dist/tests/behavior-live-check.js",
    "setup:sounds": "node scripts/setup-sounds.mjs",
    "voices:samples": "node tools/voice-match/render-samples.mjs",
    "voices:match": "node tools/voice-match/match.mjs",
    "setup:speech": "node scripts/setup-speech.mjs",
    "prepack": "npm run build",
    "release:version": "changeset version && npm install --package-lock-only --no-audit --no-fund"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@opencode/cli-darwin-arm64": "^2.1.4",
    "@opencode/cli-darwin-x64-baseline": "^2.1.4",
    "@opencode/cli-linux-arm64": "^2.1.4",
    "@opencode/cli-linux-x64-baseline": "^2.1.4",
    "@opencode/cli-windows-arm64": "^2.1.4",
    "@opencode/cli-windows-x64-baseline": "^2.1.4"
  },
  "devDependencies": {
    "@betteroffice/fonts": "0.4.0",
    "@betteroffice/pptx": "0.2.0",
    "@betteroffice/xlsx": "0.3.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.58.0",
    "@pierre/highlights": "0.2.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/node": "^24.0.0",
    "@types/katex": "^0.16.8",
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.17",
    "docx-preview": "0.4.1",
    "katex": "0.19.0",
    "jszip": "3.10.1",
    "onnxruntime-web": "^1.31.1",
    "oxlint": "^1.89.0",
    "pdfjs-dist": "^6.2.108",
    "pele": "1.7.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "vite": {
      "rolldown": "1.2.13"
    }
  }
}
